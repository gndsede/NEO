# ============================================================================
# Monorepo NEO AccessHub — regras globais (auditoria F19, ISO 27001 A.8.9)
# Cada subprojeto tem seu próprio .gitignore; estas regras são a rede de
# segurança para segredos e artefatos em QUALQUER pasta do repositório.
# ============================================================================

# Segredos e configuração local — nunca versionar
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
secrets*.json

# Dependências e builds
node_modules/
dist/
build/

# Logs
*.log
npm-debug.log*

# SO / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Storage local de desenvolvimento (contém fotos/documentos com PII)
uploads/
