# ----------------------------------------------------------------------------
# Servidor
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
# Origens permitidas no CORS (separadas por vírgula). Use * apenas em dev.
# Em PRODUÇÃO é OBRIGATÓRIO (o boot falha com "*" ou ausente).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Número de proxies confiáveis à frente da API (nginx/load balancer = 1).
# Em PRODUÇÃO é OBRIGATÓRIO declarar explicitamente (Railway/ELB/nginx = 1;
# sem proxy = 0). Sem isso o rate limit por IP não funciona e o boot falha.
TRUST_PROXY=0

# ----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Ex.: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accesshub?schema=public"

# ----------------------------------------------------------------------------
# Autenticação (JWT)
# OBRIGATÓRIO: gere um segredo forte e único por ambiente. NUNCA use o exemplo.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# ----------------------------------------------------------------------------
# E-mail transacional (Resend) — convites e redefinição de senha.
# Opcional: sem RESEND_API_KEY, os e-mails simplesmente não são enviados
# (o restante do fluxo continua funcionando normalmente).
# ----------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="notificacoes@accesshub.com.br"
FRONTEND_URL="http://localhost:5173"

# ----------------------------------------------------------------------------
# LGPD — criptografia de CPF/RG (AES-256). Hex de 64 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: depois de ativada, NUNCA troque a chave (dados ficariam ilegíveis).
# ----------------------------------------------------------------------------
ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Crachá / QR Code
# Segredo usado para assinar o hash de acesso embutido no QR code.
# Gere um valor forte como o JWT_SECRET.
# ----------------------------------------------------------------------------
BADGE_HASH_SECRET=
# Base usada para montar a URL/payload de validação do QR (opcional).
BADGE_VERIFY_BASE_URL="https://accesshub.example.com/verify"

# ----------------------------------------------------------------------------
# Storage de arquivos
# Driver: "local" | "s3" | "supabase"
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local

# --- Driver local (desenvolvimento) ---
LOCAL_STORAGE_DIR=uploads
# URL pública base servida pela própria API para os arquivos locais.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3333/files

# --- Driver S3 (AWS / compatível: MinIO, R2, etc.) ---
S3_REGION=us-east-1
S3_BUCKET=accesshub-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint customizado (MinIO/R2). Deixe vazio para AWS S3 padrão.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# URL pública/CDN base (opcional). Se vazio, gera URL padrão do bucket.
S3_PUBLIC_URL=

# --- Driver Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=accesshub-files
