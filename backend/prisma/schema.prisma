// ============================================================================
// AccessHub — Gestão de Documentação e Controle de Acesso para Obras
// Prisma Schema (PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: a connection string fica em prisma.config.ts (datasource.url)
  // e o runtime usa o driver adapter @prisma/adapter-pg.
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// Perfil base: usuário interno ou colaborador/representante de empreiteira.
enum UserProfile {
  USER
  COLLABORATOR
}

/// Situação de um colaborador no vínculo com a obra (WorkerAssignment).
enum WorkerStatus {
  ACTIVE
  INACTIVE
  BLOCKED // Bloqueado (ex.: documentação irregular)
}

/// A quem o documento pertence (tabela polimórfica).
enum DocumentOwnerType {
  WORKER
  CONTRACTOR
}

/// Classificação do documento: de segurança do trabalho (ASO, NRs, EPI...) ou
/// padrão/administrativo (identificação, contrato, etc.). O tipo específico
/// do documento é descrito pelo campo `name` do registro/documento.
enum DocumentType {
  SAFETY // Documento de segurança do trabalho
  STANDARD // Documento padrão/administrativo
}

/// Status do workflow de aprovação documental.
enum DocumentStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

/// Frequência de cobrança do registro documental.
enum RequirementFrequency {
  ONE_TIME
  BY_EXPIRY
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  FOUR_MONTHLY
  SEMIANNUAL
  ANNUAL
}

/// Define se o envio do documento pede a competência (período de referência,
/// ex.: "mês/ano a que o ASO se refere").
enum CompetenceMode {
  NONE
  ALLOWED
  REQUIRED
}

/// Alvo da regra de documentação.
enum RequirementTarget {
  WORKER
  CONTRACTOR
}

/// Origem da exigência em nível de pessoa/fornecedor.
enum RequirementSource {
  FUNCTION_TEMPLATE
  CONTRACTOR_TYPE_TEMPLATE
  MANUAL
}

/// Situação da coleta do registro documental.
enum RequirementCollectionStatus {
  NOT_SENT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NOT_APPLICABLE
}

/// Estágio fino dentro de uma coleta em andamento (visão operacional da aba Pendentes).
enum RequirementStage {
  NONE
  AWAITING_UPLOAD // exigência criada, sem anexo
  AWAITING_SIGNATURE // anexo enviado, falta assinatura
  AWAITING_REVIEW // pronto para o avaliador
}

/// Situação efetiva (derivada de status + datas) que alimenta os ícones do funil.
/// Desnormalizada em coluna indexada para listar/contar rápido com 1000+ colaboradores.
enum EffectiveRequirementStatus {
  EM_FALTA // NOT_SENT
  AGUARDANDO // PENDING_APPROVAL
  REPROVADO // REJECTED
  VIGENTE // APPROVED, dentro da validade
  PROX_VENCIMENTO // APPROVED, vence em <= 30 dias
  VENCIDO // APPROVED, validade expirada
  NA // NOT_APPLICABLE
}

/// Direção do evento na catraca.
enum AccessDirection {
  ENTRY
  EXIT
}

/// Resultado da tentativa de acesso.
enum AccessResult {
  GRANTED
  DENIED
}

/// Tipo de notificação enviada por email.
enum NotificationType {
  DOCUMENT_EXPIRING_7D
  DOCUMENT_EXPIRED
  DOCUMENT_REJECTED
}

// ----------------------------------------------------------------------------
// Tenancy / Identidade
// ----------------------------------------------------------------------------

/// Tenant principal do SaaS. Representa o cliente contratante (a Obra/Cliente).
/// Toda a hierarquia (empreiteiras, colaboradores, documentos) pende de uma Company.
model Company {
  id           String   @id @default(cuid())
  name         String
  legalName    String? // Razão social
  document     String?  @unique // CNPJ do cliente
  // Endereço/identificação da obra
  siteName     String? // Nome da obra (ex.: "Centro Empresarial — SP")
  addressLine  String?
  city         String?
  state        String?
  active       Boolean  @default(true)

  // Campos de gestão SaaS (gerenciados pelo super-admin)
  plan             String    @default("STARTER") // STARTER | PROFISSIONAL | ENTERPRISE
  blocked          Boolean   @default(false)
  licenseExpiresAt DateTime?
  workerLimit      Int?
  accessToken      String?   @unique // Token de API gerado para integrações

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  obras       Obra[]
  contractors Contractor[]
  workers     Worker[]
  workerAssignments            WorkerAssignment[]
  documents   Document[]
  accessLogs  AccessLog[]
  workerFunctions              WorkerFunction[]
  contractorTypes              ContractorType[]
  requirementDefinitions       DocumentRequirementDefinition[]
  workerRequirementItems       WorkerRequirementItem[]
  contractorRequirementItems   ContractorRequirementItem[]
  notificationLogs             NotificationLog[]
  rdos                         Rdo[]
  userGroups                   UserGroup[]
  saContracts                  SaContract[]
  saInvoices                   SaInvoice[]
  supportTickets               SupportTicket[]

  @@index([active])
  @@map("companies")
}

/// Usuário do sistema, sempre vinculado a uma Company (tenant).
model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  profile      UserProfile @default(USER)
  contractorId String?
  contractor   Contractor? @relation("UserContractor", fields: [contractorId], references: [id], onDelete: SetNull)
  /// Lista de permissões (chaves de ação) concedidas ao usuário.
  permissions  Json?
  active       Boolean  @default(true)
  /// Segredo TOTP (base32) para autenticação de dois fatores via Google Authenticator.
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  /// Códigos de backup do 2FA (hashes bcrypt, uso único). Gerados na ativação;
  /// cada uso remove o hash consumido. Null = nunca gerados.
  totpBackupCodes Json?
  /// Token de convite (definir senha do primeiro acesso). Único e de uso único;
  /// limpo assim que a senha é definida. Usuário fica com active=false até lá.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  /// Token de redefinição de senha ("esqueci minha senha"). Único e de uso
  /// único; limpo assim que a nova senha é definida ou o token expira.
  resetPasswordToken          String?   @unique
  resetPasswordTokenExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Auditoria: documentos avaliados (aprovados/rejeitados) por este usuário.
  reviewedDocuments Document[] @relation("DocumentReviewer")
  // Auditoria: documentos enviados/anexados por este usuário.
  uploadedDocuments Document[] @relation("DocumentUploader")
  // Acessos registrados por este operador (quando manual).
  registeredAccess  AccessLog[] @relation("AccessOperator")
  createdWorkerRequirementItems     WorkerRequirementItem[]   @relation("WorkerRequirementCreatedBy")
  createdContractorRequirementItems ContractorRequirementItem[] @relation("ContractorRequirementCreatedBy")
  obraAccess                        UserObraAccess[]
  createdRdos                       Rdo[]                     @relation("RdoCreatedBy")
  approvedRdos                      Rdo[]                     @relation("RdoApprovedBy")
  groupMemberships                  UserGroupMember[]
  requirementDefinitionAccess       RequirementDefinitionUserAccess[]

  @@index([companyId])
  @@index([contractorId])
  @@map("users")
}

/// Obra / canteiro vinculado à empresa contratante.
model Obra {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  addressLine String?
  city        String?
  state       String?
  active               Boolean   @default(true)
  dataInicio           DateTime?
  dataTerminoPrevisto  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userAccess        UserObraAccess[]
  contractors       Contractor[]
  workerAssignments WorkerAssignment[]
  rdos              Rdo[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("obras")
}

/// Obras liberadas para cada usuário (exceto OWNER/ADMIN, que veem todas).
model UserObraAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  obraId    String
  obra      Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, obraId])
  @@index([obraId])
  @@map("user_obra_access")
}

// ----------------------------------------------------------------------------
// Empreiteira (Contractor)
// ----------------------------------------------------------------------------

/// Empreiteira/terceiro vinculado a uma obra (Company).
model Contractor {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obraId      String
  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  typeId      String?
  type        ContractorType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  name        String
  legalName   String?
  cnpj        String?
  email       String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workerAssignments WorkerAssignment[]
  documents         Document[]
  requirementItems  ContractorRequirementItem[]
  linkedUsers       User[]                      @relation("UserContractor")

  @@unique([obraId, cnpj])
  @@index([companyId])
  @@index([obraId])
  @@index([typeId])
  @@map("contractors")
}

// ----------------------------------------------------------------------------
// Colaborador (Worker + WorkerAssignment)
// ----------------------------------------------------------------------------

/// Identidade pessoal do colaborador — compartilhada entre todas as obras.
/// Dados que mudam por obra (função, turno, status, empreiteira) ficam em WorkerAssignment.
model Worker {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Dados pessoais — comuns a todas as obras
  fullName  String
  /// CPF armazenado em texto plano ou criptografado com AES-256-GCM (quando ENCRYPTION_KEY está definida).
  /// Use cpfHash para buscas exatas e verificação de unicidade.
  cpf       String
  /// Hash determinístico do CPF (HMAC-SHA256 ou SHA256 sem chave).
  /// Permite verificar unicidade sem expor o número do documento.
  cpfHash   String
  /// RG armazenado criptografado com AES-256-GCM quando ENCRYPTION_KEY está definida.
  rg        String?
  birthDate DateTime?
  email     String?
  phone     String?
  photoUrl  String?

  /// Token único do crachá (padrão NEO-0A0AA0) — conteúdo do QR Code.
  /// Um único crachá funciona em todas as obras onde o colaborador está vinculado.
  qrHash    String @unique

  /// Preenchido quando o titular exerceu o direito de apagamento (LGPD Art. 18).
  /// Os campos de PII são substituídos por valores anônimos; logs de acesso são preservados.
  anonymizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments      WorkerAssignment[]
  documents        Document[]
  accessLogs       AccessLog[]
  requirementItems WorkerRequirementItem[]

  @@unique([companyId, cpfHash])
  @@index([companyId])
  @@map("workers")
}

/// Vínculo do colaborador com uma obra específica.
/// Um colaborador pode ter N vínculos (um por obra), cada um com seus próprios
/// requisitos, status, turno e empreiteira.
model WorkerAssignment {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  obraId       String
  obra         Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  functionId   String?
  function     WorkerFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)

  /// Função descritiva nesta obra (ex.: "Pedreiro", "Eletricista").
  role         String
  registration String?  // Matrícula específica desta obra
  /// Data de início do colaborador nesta obra — referência para coleta periódica.
  admissionDate DateTime?
  shiftStart   String?
  shiftEnd     String?
  status       WorkerStatus @default(ACTIVE)
  /// Validade do acesso nesta obra (derivada dos requisitos; cacheável).
  accessValidUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirementItems WorkerRequirementItem[]

  @@unique([obraId, workerId])
  @@index([workerId])
  @@index([obraId])
  @@index([contractorId])
  @@index([companyId, status])
  @@map("worker_assignments")
}

// ----------------------------------------------------------------------------
// Documento (polimórfico: pertence a Worker OU a Contractor)
// ----------------------------------------------------------------------------

/// Cadastro mestre de exigências documentais do tenant.
/// Ex.: "ASO Periódico", "NR-35", "Contrato Social".
model DocumentRequirementDefinition {
  id            String               @id @default(cuid())
  companyId     String
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  target        RequirementTarget
  name          String
  description   String?
  documentType  DocumentType
  frequency     RequirementFrequency
  monthlyDueDay Int?
  referenceDate DateTime?

  /// Formatos de arquivo aceitos no anexo (texto livre, ex.: "PDF, JPG"). Vazio = qualquer formato.
  attachmentFormats     String?
  /// Se o anexo é obrigatório para considerar o registro atendido.
  attachmentRequired    Boolean        @default(true)
  /// Se o envio pede/obriga informar a competência (período de referência).
  competenceMode        CompetenceMode @default(NONE)
  /// Instruções/observações exibidas a quem for anexar o documento.
  observations          String?
  /// Se, quando pendente, este registro bloqueia a liberação na catraca virtual.
  grantsTurnstileAccess Boolean        @default(false)

  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workerFunctionRequirements   WorkerFunctionRequirement[]
  contractorTypeRequirements   ContractorTypeRequirement[]
  workerRequirementItems       WorkerRequirementItem[]
  contractorRequirementItems   ContractorRequirementItem[]
  groupAccess                  RequirementDefinitionGroupAccess[]
  userAccess                   RequirementDefinitionUserAccess[]

  @@index([companyId, target, active])
  @@index([companyId, documentType])
  @@map("document_requirement_definitions")
}

/// Grupo de usuários (equipe/departamento), usado para conceder acesso a
/// registros documentais específicos de forma coletiva.
model UserGroup {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           UserGroupMember[]
  requirementAccess RequirementDefinitionGroupAccess[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("user_groups")
}

/// Associação N:N entre grupo e usuário.
model UserGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("user_group_members")
}

/// Concede acesso de um grupo de usuários a um registro documental específico.
model RequirementDefinitionGroupAccess {
  id            String                         @id @default(cuid())
  requirementId String
  requirement   DocumentRequirementDefinition  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  groupId       String
  group         UserGroup                      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime                       @default(now())

  @@unique([requirementId, groupId])
  @@map("requirement_definition_group_access")
}

/// Concede acesso de um usuário específico a um registro documental específico.
model RequirementDefinitionUserAccess {
  id            String                         @id @default(cuid())
  requirementId String
  requirement   DocumentRequirementDefinition  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  userId        String
  user          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime                       @default(now())

  @@unique([requirementId, userId])
  @@map("requirement_definition_user_access")
}

/// Catálogo de funções de colaborador (Pedreiro, Eletricista, etc.).
model WorkerFunction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments   WorkerAssignment[]
  requirements  WorkerFunctionRequirement[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("worker_functions")
}

/// Associação N:N entre função e exigências documentais.
model WorkerFunctionRequirement {
  id            String                       @id @default(cuid())
  functionId    String
  function      WorkerFunction               @relation(fields: [functionId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   DocumentRequirementDefinition @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  required      Boolean                      @default(true)

  @@unique([functionId, requirementId])
  @@map("worker_function_requirements")
}

/// Catálogo de tipos de fornecedor (Transportadora, Locação, etc.).
model ContractorType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contractors  Contractor[]
  requirements ContractorTypeRequirement[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("contractor_types")
}

/// Associação N:N entre tipo de fornecedor e exigências documentais.
model ContractorTypeRequirement {
  id            String                        @id @default(cuid())
  contractorTypeId String
  contractorType ContractorType               @relation(fields: [contractorTypeId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   DocumentRequirementDefinition @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  required      Boolean                       @default(true)

  @@unique([contractorTypeId, requirementId])
  @@map("contractor_type_requirements")
}

/// Exigência documental em nível de colaborador (coleta operacional).
/// Scoped ao vínculo (WorkerAssignment) — cada obra tem seus próprios itens.
model WorkerRequirementItem {
  id             String                     @id @default(cuid())
  companyId      String
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId       String
  worker         Worker                     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// Vínculo específico (obra) ao qual esta exigência pertence.
  assignmentId   String?
  assignment     WorkerAssignment?          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requirementId  String?
  requirement    DocumentRequirementDefinition? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  source         RequirementSource
  status         RequirementCollectionStatus @default(NOT_SENT)
  naReason       String?
  // Snapshot da regra no momento da criação (suporta edição do catálogo sem perder histórico).
  name           String
  documentType   DocumentType
  frequency      RequirementFrequency
  monthlyDueDay  Int?
  referenceDate  DateTime?
  latestDocumentId String?
  latestDocument Document?                  @relation("WorkerRequirementLatestDocument", fields: [latestDocumentId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?                      @relation("WorkerRequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  // --- Nova camada "entidade com status" (funil + visão operacional) ---
  /// Prazo desejado de aprovação (deadline). Alimenta os filtros da aba Pendentes.
  dueDate         DateTime?
  /// Estágio fino dentro de uma coleta pendente.
  stage           RequirementStage @default(NONE)
  /// Situação efetiva derivada (status + datas). Recalculada a cada mudança e no job diário.
  effectiveStatus EffectiveRequirementStatus @default(EM_FALTA)
  /// Validade copiada do latestDocument (índice para ordenar/filtrar vencimentos).
  expiresAt       DateTime?

  submittedDocuments Document[]             @relation("WorkerRequirementDocuments")

  @@index([companyId, workerId, status])
  @@index([requirementId])
  @@index([assignmentId])
  @@index([companyId, effectiveStatus]) // funil por situação
  @@index([companyId, dueDate]) // ordenar por deadline
  @@index([workerId, effectiveStatus]) // chips por colaborador
  @@unique([latestDocumentId])
  @@map("worker_requirement_items")
}

/// Exigência documental em nível de fornecedor (coleta operacional).
model ContractorRequirementItem {
  id             String                     @id @default(cuid())
  companyId      String
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorId   String
  contractor     Contractor                 @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  requirementId  String?
  requirement    DocumentRequirementDefinition? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  source         RequirementSource
  status         RequirementCollectionStatus @default(NOT_SENT)
  naReason       String?
  name           String
  documentType   DocumentType
  frequency      RequirementFrequency
  monthlyDueDay  Int?
  referenceDate  DateTime?
  latestDocumentId String?
  latestDocument Document?                  @relation("ContractorRequirementLatestDocument", fields: [latestDocumentId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?                      @relation("ContractorRequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  submittedDocuments Document[]             @relation("ContractorRequirementDocuments")

  @@index([companyId, contractorId, status])
  @@index([requirementId])
  @@unique([latestDocumentId])
  @@map("contractor_requirement_items")
}

/// Documento anexado a um Worker ou a uma Contractor.
/// Polimorfismo via discriminador `ownerType` + FKs nuláveis (`workerId`/`contractorId`).
/// Regra de integridade: exatamente uma das FKs deve estar preenchida, coerente com `ownerType`
/// (aplicada na camada de serviço e, opcionalmente, via CHECK constraint em migration).
model Document {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerType DocumentOwnerType
  workerId     String?
  worker       Worker?     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workerRequirementItemId     String?
  workerRequirementItem       WorkerRequirementItem? @relation("WorkerRequirementDocuments", fields: [workerRequirementItemId], references: [id], onDelete: SetNull)
  contractorRequirementItemId String?
  contractorRequirementItem   ContractorRequirementItem? @relation("ContractorRequirementDocuments", fields: [contractorRequirementItemId], references: [id], onDelete: SetNull)

  type        DocumentType
  title       String? // Rótulo livre (ex.: "ASO admissional")
  fileUrl     String // URL no storage
  fileKey     String? // Chave/objeto no bucket (para exclusão/assinatura)
  mimeType    String?
  fileSize    Int?
  issuedAt    DateTime? // Data de emissão
  expiresAt   DateTime? // Data de validade

  // Workflow de aprovação + auditoria
  status          DocumentStatus @default(PENDENTE)
  uploadedById    String?
  uploadedBy      User?          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  workerRequirementItemAsLatest     WorkerRequirementItem?     @relation("WorkerRequirementLatestDocument")
  contractorRequirementItemAsLatest ContractorRequirementItem? @relation("ContractorRequirementLatestDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([workerId])
  @@index([contractorId])
  @@index([workerRequirementItemId])
  @@index([contractorRequirementItemId])
  @@index([uploadedById])
  @@index([ownerType, status])
  @@index([expiresAt])
  @@map("documents")
}

// ----------------------------------------------------------------------------
// Log de acesso (Catraca)
// ----------------------------------------------------------------------------

/// Registro de cada evento de acesso na catraca/portaria.
model AccessLog {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId  String?
  worker    Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)

  direction AccessDirection
  result    AccessResult    @default(GRANTED)
  reason    String? // Motivo de negação (ex.: "ASO vencido", "QR inválido")
  gate      String? // Identificação da catraca/portão
  qrHash    String? // Hash lido (auditoria mesmo se worker não resolvido)

  // Operador que registrou (quando aplicável)
  operatorId String?
  operator   User?    @relation("AccessOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  // ID gerado pelo app no modo offline. Garante idempotência do batch:
  // o reenvio da fila (quando a resposta se perde) não duplica o registro.
  // Nulo em scans online; NULLs são distintos no índice único (Postgres).
  clientId String?

  occurredAt DateTime @default(now())

  @@unique([companyId, clientId])
  @@index([companyId, occurredAt])
  @@index([workerId, occurredAt])
  @@map("access_logs")
}

// ----------------------------------------------------------------------------
// Notificações
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// RDO — Relatório Diário de Obra
// ----------------------------------------------------------------------------

enum RdoStatus {
  PENDENTE            // criado, ainda não enviado para aprovação
  AGUARDANDO_APROVACAO // enviado, aguardando revisor
  APROVADO            // aprovado pelo responsável
  REPROVADO           // reprovado — requer correção e reenvio
}

/// Relatório Diário de Obra. Arrays dinâmicos (efetivos, equipamentos, etc.)
/// são persistidos como JSON para manter o schema flat sem N tabelas extras.
model Rdo {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obraId    String?
  obra      Obra?    @relation(fields: [obraId], references: [id], onDelete: SetNull)

  // Dados do Empreendimento
  contratoNumero  String?
  docNumero       String?
  data            DateTime
  turnos          String?
  jornadaTrabalho String?
  localidade      String?
  dataInicio      DateTime?
  dataTermino     DateTime?
  diasDecorridos  Int?
  diasRestantes   Int?
  diasAtraso      Int?
  prorrogacao     DateTime?

  // Condições Climáticas
  climaManha   String?
  climaTarde   String?
  climaNoite   String?
  chuvaQuantMm Float?

  // Arrays JSON: [{ empresa, efetivo }]
  efetivoIndireta Json @default("[]")
  efetivoODireta  Json @default("[]")

  // Array JSON: [{ equipamento, quantidade }]
  equipamentos Json @default("[]")

  // Array JSON: [{ atividadeExecutada, status }]
  atividades Json @default("[]")

  // Array JSON: [{ fornecedor, material, nfRecebidas }]
  materiais Json @default("[]")

  // Considerações
  consideracoesContratada   String?
  consideracoesFiscalizacao String?

  // Array JSON: [{ fileUrl, fileKey, caption }]
  fotos Json @default("[]")

  // Array JSON: [{ fileUrl, fileKey, fileName }]
  arquivos Json @default("[]")

  status          RdoStatus @default(PENDENTE)
  createdById     String?
  createdBy       User?     @relation("RdoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?     @relation("RdoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, data])
  @@index([companyId, status])
  @@index([obraId])
  @@map("rdos")
}

// ----------------------------------------------------------------------------
// Super-Admin — sistema paralelo ao tenant, gerencia o SaaS
// ----------------------------------------------------------------------------

/// Administrador da plataforma NEO (nível acima dos tenants).
model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("super_admins")
}

/// Contrato de licenciamento entre NEO e um tenant.
model SaContract {
  id             String    @id @default(cuid())
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tenantName     String
  tenantCnpj     String?
  plan           String
  monthlyValue   Float
  contractMonths Int
  startDate      DateTime
  endDate        DateTime
  status         String    @default("DRAFT") // DRAFT | SENT | SIGNED | CANCELLED
  signedAt       DateTime?
  clauses        Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@map("sa_contracts")
}

/// Fatura gerada para um tenant.
model SaInvoice {
  id          String    @id @default(cuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  description String
  amount      Float
  dueDate     DateTime
  paidAt      DateTime?
  status      String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("sa_invoices")
}

/// Ticket de suporte aberto por um tenant.
model SupportTicket {
  id          String        @id @default(cuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  authorEmail String
  authorName  String
  subject     String
  status      String        @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority    String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  replies     TicketReply[]

  @@index([companyId])
  @@index([status])
  @@map("support_tickets")
}

/// Resposta a um ticket de suporte.
model TicketReply {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorEmail String
  authorName  String
  body        String
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

/// Trilha de auditoria genérica (LGPD Art. 37 — registro das operações de
/// tratamento; ISO 27001 A.8.15; OWASP A09:2021). Registra ações administrativas
/// sensíveis: exportações de PII, logins, mudanças de permissão, exclusões.
/// Sem FKs propositalmente: a trilha deve sobreviver à exclusão de usuários
/// e empresas (accountability perante a ANPD).
model AuditLog {
  id         String   @id @default(cuid())
  /// Tenant onde a ação ocorreu (null para ações de super-admin/plataforma).
  companyId  String?
  /// Usuário que executou a ação (null para tentativas anônimas, ex.: login falho).
  actorId    String?
  /// E-mail do ator no momento da ação (snapshot — sobrevive a alterações).
  actorEmail String?
  /// Ação em formato NAMESPACE_VERBO, ex.: EXPORT_WORKERS_PII, LOGIN_FAILED.
  action     String
  entityType String?
  entityId   String?
  /// IP de origem (respeitando TRUST_PROXY).
  ip         String?
  /// Contexto adicional (filtros de export, permissões alteradas, etc.).
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Registro de emails enviados — impede reenvio duplicado dentro da janela de dedup.
model NotificationLog {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           NotificationType
  /// "contractor_digest" | "document"
  targetType     String
  /// contractorId (digest agendado) ou documentId (rejeição imediata)
  targetId       String
  recipientEmail String
  sentAt         DateTime         @default(now())

  @@index([targetId, type, sentAt])
  @@index([companyId, sentAt])
  @@map("notification_logs")
}
